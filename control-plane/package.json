{
  "name": "@autosploit/control-plane",
  "version": "0.0.0",
  "private": true,
  "description": "Autosploit control plane — trusted API wrapping the attack engine (docs/control-plane.md). Bun package manager, Node 22 runtime.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.1.0",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@fastify/cookie": "9",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-fastify": "^10.0.0",
    "bullmq": "^5.0.0",
    "dotenv": "^16.0.0",
    "drizzle-orm": "^0.30.0",
    "ioredis": "^5.3.0",
    "jose": "^5.0.0",
    "node-vault": "^0.12.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@testcontainers/postgresql": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.21.0",
    "eslint": "^9.0.0",
    "fastify": "4.28.1",
    "supertest": "^7.0.0",
    "testcontainers": "^10.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.6.0"
  }
}
