# Control plane — env template. Copy to .env. NEVER commit .env.
# Secret split (docs/control-plane.md §6): OPENROUTER_API_KEY is conductor-only,
# it MUST NOT appear here — the control plane never holds the model key.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Postgres (system of record) ---
DATABASE_URL=postgres://autosploit:autosploit@localhost:5432/control_plane

# --- Redis (BullMQ dispatch + SSE last-mile) ---
REDIS_URL=redis://localhost:6379

# --- Redpanda / Kafka (event backbone) ---
# Empty KAFKA_BROKERS = broker disabled (app boots; ingest returns 503).
KAFKA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_TOPIC=autosploit.events
KAFKA_CLIENT_ID=control-plane

# --- GitHub OAuth (Identity slice A) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/callback

# --- Auth / sessions ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Signing key shared C(mint) <-> D(validate) for per-engagement ingest tokens (§8.1)
INGEST_TOKEN_SIGNING_KEY=

# --- Vault (token vault, Transit engine, k8s auth — §9.1) ---
VAULT_ADDR=http://localhost:8200
VAULT_TRANSIT_KEY=github-tokens

# --- Object store (reports / logs / memory bundles) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=autosploit-reports
S3_ACCESS_KEY=
S3_SECRET_KEY=
# TTL (seconds) of the presigned artifact download URLs the report serves.
REPORT_URL_TTL_S=900

# --- Conductor CLI (Phase A worker shells this) ---
CONDUCTOR_CMD=conductor
# Base --out dir for `conductor run`; the surviving conductor.json record lives
# at <out>/<engagement-id>/conductor.json (the worker reads it for the terminal state).
CONDUCTOR_OUT_DIR=/tmp/autosploit-runs
# Wall-clock timeout (seconds) passed as `conductor run --timeout-s`.
CONDUCTOR_TIMEOUT_S=3600
